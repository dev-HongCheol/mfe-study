{
  "mfe-workflow-harness": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "node ../scripts/inject-context.mjs --session-start",
        "timeout": 10
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "node ../scripts/inject-context.mjs",
        "timeout": 10
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/verify-scope.mjs",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "run_command",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/verify-todo-before-merge.mjs",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_file|edit_file",
        "hooks": [
          {
            "type": "command",
            "command": "node ../scripts/auto-format.mjs",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "node ../scripts/verify-stop-gate.mjs",
        "timeout": 30
      }
    ]
  }
}
